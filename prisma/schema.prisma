// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum TaskStatus {
    PENDING
    IN_PROGRESS
    BLOCKED
    COMPLETED
    CANCELLED
    SKIPPED
}

model User {
    id      String @id @default(cuid())
    clerkId String @unique

    email String  @unique
    name  String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tasks              Task[]
    categories         Category[]
    tags               Tag[]
    recurringTemplates RecurringTemplate[]
    userSettings       UserSettings?
}

model UserSettings {
    id       String @id @default(cuid())
    timezone String @default("Europe/Stockholm")
    locale   String @default("en")

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @unique
}

model Task {
    id String @id @default(cuid())

    title           String
    description     String?
    status          TaskStatus @default(PENDING)
    dueDate         DateTime?
    externalContact String?
    link            String?
    completedAt     DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    blockedBy   Task?   @relation("TaskBlocker", fields: [blockedById], references: [id])
    blockedById String?
    blocking    Task[]  @relation("TaskBlocker")

    notes               Note[]
    tags                Tag[]
    category            Category?          @relation(fields: [categoryId], references: [id])
    categoryId          String?
    recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
    recurringTemplateId String?

    @@index([userId, status])
    @@index([userId, dueDate])
}

enum RecurrenceType {
    DAILY
    WEEKLY
    MONTHLY
}

model RecurringTemplate {
    id String @id @default(cuid())

    title           String
    description     String?
    externalContact String?
    link            String?

    recurrenceType RecurrenceType
    dayOfWeek      Int?
    dayOfMonth     Int?
    nextDueDate    DateTime

    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tasks      Task[]
    category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    categoryId String?
    userId     String

    @@index([userId])
}

model Category {
    id String @id @default(cuid())

    name  String
    color String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tasks              Task[]
    user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId             String
    recurringTemplates RecurringTemplate[]

    @@unique([userId, name])
    @@index([userId])
}

model Note {
    id String @id @default(cuid())

    content String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
    taskId String

    @@index([taskId])
}

model Tag {
    id String @id @default(cuid())

    name  String
    color String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tasks  Task[]
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@unique([userId, name])
}
